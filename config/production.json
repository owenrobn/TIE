{
  "app": {
    "port": 8080
  },
  "database": {
    "host": "postgres",
    "password": "${DB_PASSWORD}"
  },
  "redis": {
    "host": "redis"
  },
  "chains": {
    "ethereum": {
      "rpc": "${ETHEREUM_RPC_URL}",
      "wsRpc": "${ETHEREUM_WS_RPC_URL}"
    },
    "arbitrum": {
      "rpc": "${ARBITRUM_RPC_URL}",
      "wsRpc": "${ARBITRUM_WS_RPC_URL}"
    },
    "optimism": {
      "rpc": "${OPTIMISM_RPC_URL}",
      "wsRpc": "${OPTIMISM_WS_RPC_URL}"
    },
    "base": {
      "rpc": "${BASE_RPC_URL}",
      "wsRpc": "${BASE_WS_RPC_URL}"
    }
  },
  "security": {
    "webhookSecret": "${WEBHOOK_SECRET}",
    "enableHMAC": true,
    "taeWebhookUrl": "http://tie-engine:8080/api/tae/signal",
    "taeReportingWebhookUrl": "${TAE_REPORTING_WEBHOOK_URL}",
    "etherscanApiKey": "${ETHERSCAN_API_KEY}"
  }
}