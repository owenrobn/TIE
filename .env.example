# Testnet Intelligence Engine - Environment Variables

# Application
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tie_db
DB_USER=tie_user
DB_PASSWORD=tie_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Chain RPC URLs
ETHEREUM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
ARBITRUM_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/your-api-key
OPTIMISM_RPC_URL=https://opt-sepolia.g.alchemy.com/v2/your-api-key
BASE_RPC_URL=https://base-sepolia.g.alchemy.com/v2/your-api-key

# Security
WEBHOOK_SECRET=your-webhook-secret-key
HMAC_ENABLED=true

# Simulation
MAX_CONCURRENT_SIMULATIONS=5
SIMULATION_TIMEOUT=3000